<idea-plugin>
    <id>io.github.paulirwin.squill-rider</id>
    <name>Squill</name>
    <vendor url="https://github.com/paulirwin/squill-rider">Paul Irwin</vendor>

    <description><![CDATA[
        IDE support for <a href="https://github.com/paulirwin/squill">Squill</a> database projects in Rider.
        <br/>
        Squill brings SSDT-style declarative, code-first database projects and DACPAC deployments to
        PostgreSQL and MariaDB/MySQL. This plugin adds IDE support for editing and building
        <code>.squillproj</code> projects.
    ]]></description>

    <!-- Rider-targeted: the plugin registers a frontend project-model icon provider that gives
         .squillproj projects a database icon in Solution Explorer. -->
    <depends>com.intellij.modules.rider</depends>

    <extensions defaultExtensionNs="com.intellij.rider">
        <!-- The Solution Explorer project-node icon is frontend-owned (calculateIcon queries
             this EP first). Registering a provider is the supported way to icon a project node;
             a ReSharper backend presenter is NOT consulted for it. -->
        <projectModelIconProvider
            implementation="io.github.paulirwin.squill.rider.SquillProjectIconProvider" />
    </extensions>
</idea-plugin>
